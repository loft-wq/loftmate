rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pigeons collection - users can only access their own pigeons
    match /pigeons/{pigeonId} {
      allow read, write: if request.auth != null && 
        resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.ownerId == request.auth.uid;
    }
    
    // Races collection - users can read all races but only create/update their own entries
    match /races/{raceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        resource.data.organizerId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.organizerId == request.auth.uid;
    }
    
    // Race entries - users can only access their own entries
    match /raceEntries/{entryId} {
      allow read, write: if request.auth != null && 
        resource.data.participantId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.participantId == request.auth.uid;
    }
    
    // Breeding records - users can only access their own records
    match /breedingRecords/{recordId} {
      allow read, write: if request.auth != null && 
        resource.data.breederId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.breederId == request.auth.uid;
    }
    
    // Health records - users can only access their own pigeons' health records
    match /healthRecords/{recordId} {
      allow read, write: if request.auth != null && 
        resource.data.pigeonOwnerId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.pigeonOwnerId == request.auth.uid;
    }
  }
}