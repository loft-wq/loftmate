rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Users can only upload and access their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pigeon images - users can only access their own pigeons' images
    match /pigeons/{pigeonId}/{allPaths=**} {
      allow read, write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/pigeons/$(pigeonId)).data.ownerId == request.auth.uid;
    }
    
    // Race documents - users can read all race documents but only upload their own
    match /races/{raceId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/races/$(raceId)).data.organizerId == request.auth.uid;
    }
  }
}